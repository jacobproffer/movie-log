---
import Container from "@components/Container.astro";
const year = new Date().getFullYear();
---

<footer class="mt-24">
  <Container class="pb-10">
    <div class="flex flex-wrap items-baseline justify-between gap-4 border-t border-rule-strong pt-4">
      <p class="font-serif text-xl italic">Lights down. Phones off.</p>
      <p class="kicker">© {year} · A personal film diary</p>
    </div>
  </Container>
</footer>
