---
import Container from "@components/Container.astro";
import Navigation from "@components/Navigation.astro";
---

<a
  class="fixed left-1/2 -top-full z-50 -translate-x-1/2 bg-ink px-4 py-1 font-mono text-xs text-paper focus:top-2"
  href="#content">Skip to main content</a
>
<header>
  <Container class="pt-6">
    <div class="flex items-baseline justify-between gap-6 border-t border-rule-strong pt-3">
      <a href="/" class="text-xl font-bold leading-none tracking-[-0.03em] hover:underline underline-offset-4">
        Movie Log
      </a>
      <Navigation />
    </div>
  </Container>
</header>
