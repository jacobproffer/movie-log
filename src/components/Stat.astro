---
interface Props {
  label: string;
  value: string | number;
}
const { label, value } = Astro.props;
---

<div class="border-t border-rule-strong pt-3">
  <dt class="kicker">{label}</dt>
  <dd class="mt-2 font-sans text-6xl font-bold leading-none tracking-[-0.04em] md:text-7xl">
    {value}
  </dd>
</div>
